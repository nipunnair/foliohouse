{
    admin off
    auto_https off
}
http://:4381 {
    bind 127.0.0.1
    root * {$FOLIO_WEB_ROOT}
    encode zstd gzip
    @private path /.private/* /content/* /node_modules/* /.git/*
    respond @private 404
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Cache-Control "no-cache"
    }
    file_server
}
