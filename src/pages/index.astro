---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import {site, works, collections, url} from '../lib/content';
const featured = works.find(w=>w.featured) || works[0];
---
<Layout image={featured?.image}>
<section class="hero">
  <div class="hero-copy"><p class="eyebrow"><span class="dot"></span>{site.eyebrow}</p><h1>{site.headline}<br /><em>{site.headlineAccent}</em></h1><p class="intro">{site.intro}</p><a class="text-link" href="#work">Explore the work <span>↓</span></a><div class="hero-note"><span>01 / A PERSONAL COLLECTION</span><span>ART, WITH ROOM TO BREATHE</span></div></div>
  {featured ? <a class="hero-art" href={url(`work/${featured.id}/`)}><div class="hero-image"><img src={url(featured.image)} alt={featured.alt} width={featured.width} height={featured.height} fetchpriority="high" /></div><div class="hero-caption"><span>IN FOCUS <strong>{featured.title}</strong></span><span>View piece ↗</span></div></a> : <div class="empty">Your first work belongs here.<p>Import an image with <code>npm run folio -- add</code>.</p></div>}
</section>
<section id="work" class="work-section"><div class="section-top"><div><p class="eyebrow">THE COLLECTION</p><h2>Selected work<span class="count">{String(works.length).padStart(2,'0')}</span></h2></div><p>Different ideas. A shared curiosity.</p></div>
<div class="filters" role="group" aria-label="Filter work"><button class="active" data-filter="all" aria-pressed="true">All work <span>{works.length}</span></button>{collections.map(c=><button data-filter={c} aria-pressed="false">{c}</button>)}</div>
<p id="result-count" class="sr-only" aria-live="polite"></p>
<div class="work-grid">{works.map((work,index)=><Card work={work} index={index}/>)}</div>
</section>
<section class="closing"><p class="eyebrow">BEYOND THE FRAME</p><h2>Every piece starts<br />with a little <em>curiosity.</em></h2><a class="text-link" href={url('about/')}>A little about this space ↗</a></section>
</Layout>
<script>
document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button=>button.addEventListener('click',()=>{
  document.querySelectorAll('[data-filter]').forEach(b=>{b.classList.toggle('active',b===button);b.setAttribute('aria-pressed',String(b===button));});
  let count=0;
  document.querySelectorAll<HTMLElement>('[data-collection]').forEach(card=>{card.hidden=button.dataset.filter!=='all'&&card.dataset.collection!==button.dataset.filter;if(!card.hidden)count++;});
  document.querySelector('#result-count')!.textContent=`Showing ${count} works`;
}));
</script>
