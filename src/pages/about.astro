---
import Layout from '../layouts/Layout.astro';
import {site,url,works} from '../lib/content';
---
<Layout title="About"><section class="about"><div><p class="eyebrow">A SPACE OF ONE’S OWN</p><h1>The work deserves<br /><em>a little room.</em></h1><p class="intro">{site.about}</p><a class="text-link" href={url('#work')}>Return to the collection ↗</a></div>{works[1]&&<img src={url(works[1].image)} alt={works[1].alt} width={works[1].width} height={works[1].height}/>}</section></Layout>
